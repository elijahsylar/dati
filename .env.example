# D.A.T.I. Backend — Environment Config
# Copy this to .env and fill in your values

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=dati_trivia
DB_PORT=3306

# Signs the login tokens. The server refuses to start while this is the
# placeholder below, unset, or shorter than 32 characters. Replace it with
# a random value, for example the output of: openssl rand -hex 32
JWT_SECRET=change_this_to_something_random
PORT=3000

# First-run setup: POST /api/auth/setup only works when this is set to a
# random value of at least 16 characters (for example: openssl rand -hex 32)
# and the request sends the same value in the X-Setup-Secret header. Empty,
# as shipped here, the route is off. Empty it again (or remove it) once the
# admin passwords are set.
SETUP_SECRET=

# Origins that receive CORS headers, for the REST API and for the Socket.io
# HTTP handshake: comma-separated, exact (scheme://host:port), no wildcard.
# Unset, only http://localhost:<PORT> gets them. The app's own pages do not
# need this. WebSocket connections are not origin-checked.
# CORS_ORIGIN=https://trivia.example.com,https://admin.example.com
